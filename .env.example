# Skopiuj do .env (cp .env.example .env). Wartości poniżej wystarczą do uruchomienia lokalnie,
# ale poza własnym komputerem ustaw własne hasło i sekret
POSTGRES_USER=roombooking
POSTGRES_PASSWORD=change-me
POSTGRES_DB=roombooking
# Dla aplikacji uruchamianej bez Dockera (npm start); docker-compose.yml podaje API własny adres z hostem db
DATABASE_URL=postgres://roombooking:change-me@localhost:5432/roombooking
# Osobna baza dla testów integracyjnych (tworzy ją docker/initdb przy pierwszym starcie bazy)
TEST_DATABASE_URL=postgres://roombooking:change-me@localhost:5432/roombooking_test
NODE_ENV=development
PORT=3000
# Minimum 32 znaki. Własny wygenerujesz: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=local-only-secret-change-me-0123456789abcdef
JWT_EXPIRES_IN=15m
