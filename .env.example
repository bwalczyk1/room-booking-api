# Skopiuj do .env i ustaw własne wartości
POSTGRES_USER=roombooking
POSTGRES_PASSWORD=change-me
POSTGRES_DB=roombooking
DATABASE_URL=postgres://roombooking:change-me@localhost:5432/roombooking
# Osobna baza dla testów integracyjnych (tworzy ją docker/initdb przy pierwszym starcie bazy)
TEST_DATABASE_URL=postgres://roombooking:change-me@localhost:5432/roombooking_test
NODE_ENV=development
PORT=3000
# Minimum 32 znaki - wygeneruj: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
